  // autoScanMods —— 起服时自动扫描 user\mods 下所有模组，按「克隆自哪把枪」把新武器自动补进上面这张表。关闭后这张表就完全不再变动。强烈建议保持开启。当前出厂值 true。
  "autoScanMods": true,
  // maxWeaponNames —— 改写任务描述文本时，武器名的显示条数上限，0 = 不截断（全部列出）。当前出厂值 0。
  "maxWeaponNames": 0,
  // sendWeaponListOnQuestAccept —— 接取任务时，额外发一条「本任务可用武器」清单，方便确认该带哪把枪。当前出厂值 true。
  "sendWeaponListOnQuestAccept": true,
  // acceptMessageMaxWeapons —— 【当前版本已不生效】原本是上面那条清单最多列几把（0 = 全列）；该键仍会解析，但已没有任何代码读取它，保留只为兼容旧配置文件。当前出厂值 0。
  "acceptMessageMaxWeapons": 0,
  // autoScanPlatformMatch —— 自动扫描的「平台匹配」开关：除克隆关系外，再按武器平台(Platform)自动建组，让没有克隆关系的武器（尤其是刀和投掷物）也能匹配上。关闭后刀和雷不会自动建组。当前出厂值 true。
  "autoScanPlatformMatch": true,
  // excludeWeapons —— 按物品 ID 排除：这里列出的武器既不进入武器池、也不参与自动扫描。当前出厂值 []（不排除任何东西）。
  "excludeWeapons": [],
  // excludeMods —— 按模组目录名排除：这里列出的模组（user\mods 下的文件夹名）整包武器都不参与。当前出厂值 []（不排除任何模组）。
  "excludeMods": []
}
